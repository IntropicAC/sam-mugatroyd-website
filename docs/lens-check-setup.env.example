# Reference only: copy the required settings into ignored .env.local or the
# existing Vercel project's environment settings. These are NOT working credentials.

# Off until the isolated branch and test recipients are ready.
LENS_CHECK_AUTH_ENABLED=false
# Keep off until the ownership migration is applied to the intended database.
LENS_CHECK_ACCOUNTS_ENABLED=false
# Set to the isolated test branch's Auth URL. The implementation also accepts
# the existing DATABASE_NEON_AUTH_BASE_URL marketplace variable.
NEON_AUTH_BASE_URL=
# Generate a unique random 32+ character secret for EACH environment.
NEON_AUTH_COOKIE_SECRET=
LENS_CHECK_AUTH_TEST_EMAILS=
LENS_CHECK_REPORT_ADMIN_EMAILS=
LENS_CHECK_REPORTING_COHORT=live
# Required for the scheduled 90-day progress-data cleanup after deployment.
CRON_SECRET=
# Optional site passwords; requires signup verification and OTP recovery UI.
LENS_CHECK_AUTH_PASSWORD_ENABLED=false
# Only list providers configured on the same Neon branch and verified for this
# environment. The isolated local launcher defaults to its existing Google dev
# provider. Microsoft needs its own app credentials in Neon first.
LENS_CHECK_AUTH_SOCIAL_PROVIDERS=

# Application emails: disabled by default. test permits only listed addresses;
# live permits customer delivery and must wait for release review.
LENS_CHECK_EMAIL_MODE=disabled
RESEND_API_KEY=
LENS_CHECK_FROM_EMAIL="Mindset Test <reading@example.invalid>"
LENS_CHECK_REPLY_TO_EMAIL=replies@example.invalid
LENS_CHECK_NOTIFY_EMAIL=notifications@example.invalid
LENS_CHECK_EMAIL_TEST_RECIPIENTS=

# Neon sends login codes itself. Configure its SMTP separately in Neon;
# setting RESEND_API_KEY here does NOT configure Neon's email delivery.
